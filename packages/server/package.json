{
  "name": "@mssqlite/server",
  "version": "0.0.0",
  "private": true,
  "description": "MSSQL compatible TDS server over SQLite module.",
  "type": "module",
  "bin": {
    "mssqlite": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "keywords": [
    "mssqlite",
    "mssql",
    "tds",
    "server",
    "sqlite"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "MIT",
  "dependencies": {
    "@mssqlite/bytes": "workspace:*",
    "@mssqlite/engine": "workspace:*",
    "@mssqlite/tds": "workspace:*"
  },
  "devDependencies": {
    "tedious": "^18.6.1"
  }
}
